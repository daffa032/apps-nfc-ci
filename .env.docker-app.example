# Mounted as /app/.env INSIDE the app container only (see compose.yaml). The
# host's own .env keeps database.default pointed at 127.0.0.1:3307 so
# `composer test`/`php spark` keep working when run directly on Windows; this
# file is what the app actually uses when accessed through Docker.
#
# Copy to .env.docker-app and fill in the password from .env.docker
# (NFC_DB_PASSWORD) — never commit the filled-in copy.

CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

database.default.hostname = database
database.default.database = nfc_local
database.default.username = nfc_user
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Configure a dedicated mail account before enabling password reset.
email.fromEmail = 'no-reply@example.test'
email.fromName = 'NFC Digital Card'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 465
email.SMTPCrypto = ssl

# Manual renewal contact shown on /dashboard/billing (no payment gateway yet).
billing.whatsapp = ''
billing.email = ''
billing.transferInstructions = ''

# Visit statistics (Pro). Long random string, e.g. output of: php -r "echo bin2hex(random_bytes(32));"
analytics.secret = ''

# GeoLite2 Country for the first-language guess (free MaxMind account). Keep real values private.
# locale.geoipAccountId = ''
# locale.geoipLicenseKey = ''
