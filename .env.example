CI_ENVIRONMENT = development
app.baseURL = 'http://localhost:8080/'

# If running via `docker compose` (see README): hostname = database, port = 3306.
# If running `php spark serve` directly on the host against the Docker database:
# hostname = 127.0.0.1, port = 3307. The two are not interchangeable.
database.default.hostname = localhost
database.default.database = nfc_local
database.default.username = nfc_user
database.default.password = ''
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306

# Configure a dedicated mail account before enabling password reset.
email.fromEmail = 'no-reply@example.test'
email.fromName = 'NFC Digital Card'
email.SMTPHost = ''
email.SMTPUser = ''
email.SMTPPass = ''
email.SMTPPort = 465
email.SMTPCrypto = ssl

# Manual renewal contact shown on /dashboard/billing (no payment gateway yet).
billing.whatsapp = ''
billing.email = ''
billing.transferInstructions = ''

# Visit statistics (Pro). Long random string, e.g. output of: php -r "echo bin2hex(random_bytes(32));"
analytics.secret = ''

# GeoLite2 Country for the first-language guess (free MaxMind account). Keep real values private.
# locale.geoipAccountId = ''
# locale.geoipLicenseKey = ''
