parameters:
    tmpDir: build/phpstan
    level: 2
    paths:
        - app
    bootstrapFiles:
        - system/Test/bootstrap.php
    excludePaths:
        analyseAndScan:
            - app/Views/*
            # CI4 ships these with @readonly on properties that carry defaults.
            - app/Config/Autoload.php
            - app/Config/DocTypes.php
            - app/Config/Mimes.php
            - app/Config/Modules.php
            - app/Config/Optimize.php
            - app/Config/Paths.php
    ignoreErrors:
        # Migrations get a BaseConnection at runtime; the interface omits these.
        -
            message: '#Call to an undefined method CodeIgniter\\Database\\ConnectionInterface::(prefixTable|insertID)\(\)\.#'
            path: app/Database/Migrations/*
    universalObjectCratesClasses:
        - CodeIgniter\Entity
        - CodeIgniter\Entity\Entity
